# Normalize line endings to LF in the repository (matches .editorconfig).
* text=auto eol=lf

# Hook entry points are run by sh — CRLF would break them on checkout with core.autocrlf=true.
.githooks/** text eol=lf

# Generated by `pnpm hint:glyphs` — collapse in diffs
apps/web/features/canvas/hint-glyphs.json linguist-generated=true

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
