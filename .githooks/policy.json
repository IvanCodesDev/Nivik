{
  "$comment": "Git policy enforced by .githooks (pre-commit, commit-msg, pre-push, post-commit). Edit here, not in the scripts.",
  "allowedAuthors": ["IvanCodesDev"],
  "allowedEmails": [],
  "deniedIdentityPattern": "cursor|claude|anthropic|openai|codex|copilot|gemini|devin|aider|windsurf|noreply@|\\bbot\\b|\\bagent\\b",
  "deniedMessagePatterns": [
    "cursoragent@cursor\\.com",
    "noreply@anthropic\\.com",
    "\\bClaude Code\\b",
    "Generated with\\b",
    "\\bGenerated by\\b.*\\b(Cursor|Claude|Codex|Copilot|ChatGPT|GPT)\\b",
    "🤖",
    "^\\s*Made-with\\s*:",
    "^\\s*Assisted-by\\s*:",
    "^\\s*Generated-by\\s*:"
  ],
  "forbiddenPaths": [
    "docs/**",
    "node_modules/",
    ".next/",
    "dist/",
    "coverage/",
    "out/",
    ".env",
    ".env.*",
    "!.env.example",
    "**/AGENTS.md",
    "**/CLAUDE.md",
    ".cursor/",
    ".claude/",
    ".codex/",
    ".agents/",
    "chromedriver/",
    "se-metadata.json",
    "qa/",
    ".edge-headless-profile*/",
    "**/*.log",
    "**/*.pem",
    "**/*.key",
    "**/*.p12",
    "**/*.pfx",
    "**/*.tsbuildinfo",
    "**/.DS_Store",
    "**/Thumbs.db"
  ],
  "maxFileSizeKB": 2048,
  "secretPatterns": [
    "sk-[A-Za-z0-9_-]{20,}",
    "AIza[0-9A-Za-z_-]{35}",
    "gh[pousr]_[A-Za-z0-9]{36,}",
    "github_pat_[A-Za-z0-9_]{22,}",
    "xox[baprs]-[A-Za-z0-9-]{10,}",
    "AKIA[0-9A-Z]{16}",
    "-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY-----",
    "(?:api[_-]?key|secret|token|password)\\s*[:=]\\s*['\"][A-Za-z0-9_\\-]{24,}['\"]"
  ],
  "secretScanSkipExtensions": [
    ".png",
    ".jpg",
    ".jpeg",
    ".gif",
    ".webp",
    ".ico",
    ".woff",
    ".woff2",
    ".ttf",
    ".otf",
    ".pdf",
    ".zip"
  ],
  "secretAllowMarker": "hooks:allow-secret"
}
