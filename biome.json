{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/dist",
      "!**/coverage",
      "!**/next-env.d.ts",
      "!**/public",
      "!docs",
      "!apps/web/features/canvas/hint-glyphs.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": true
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "next": "recommended",
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "a11y": {
        "useSemanticElements": "off"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "style": {
        "useImportType": "error",
        "noNonNullAssertion": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/agent/src/**",
        "packages/protocol/src/**",
        "packages/ir/src/**",
        "packages/templates/src/**",
        "packages/layout/src/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "The agent core is isomorphic (browser Worker + Node); inject host access via AgentDeps.",
                  "document": "The agent core is isomorphic (browser Worker + Node); inject host access via AgentDeps.",
                  "navigator": "The agent core is isomorphic (browser Worker + Node); inject host access via AgentDeps.",
                  "localStorage": "The agent core is isomorphic (browser Worker + Node); inject host access via AgentDeps.",
                  "process": "The agent core is isomorphic (browser Worker + Node); inject host access via AgentDeps.",
                  "Buffer": "The agent core is isomorphic (browser Worker + Node); use Uint8Array / TextEncoder."
                }
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
